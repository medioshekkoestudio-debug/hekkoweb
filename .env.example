# ─────────────────────────────────────────────────────────────
# Hekko — variables de entorno
# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y rellena los valores.
# Los mismos 3 primeros valores van en Vercel → Settings →
# Environment Variables (marca SUPABASE_SERVICE_ROLE_KEY como Sensitive).
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# Pública (se expone al navegador, no pasa nada)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor (NUNCA se expone al navegador). La usan las rutas de API
# para crear estrategas y para leer el seguimiento público del cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de la app. Se usa para armar los enlaces de seguimiento que
# se comparten por WhatsApp, así que tiene que ser la URL real:
#   Local:   http://localhost:3000
#   Vercel:  https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
